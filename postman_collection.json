{
  "info": {
    "name": "Personal Expense Tracker API",
    "description": "Postman Collection for testing the JWT-secured Personal Expense Tracker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Monis Jamal\",\n  \"email\": \"monis@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"monis@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories"]
            }
          }
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "Create Expense",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Internet & Cloud Server\",\n  \"description\": \"Broadband connection and cloud hosting\",\n  \"amount\": 1850.00,\n  \"expenseDate\": \"2026-11-16\",\n  \"category\": \"UTILITIES\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/expenses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "expenses"]
            }
          }
        },
        {
          "name": "Get All Expenses (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/expenses?category=UTILITIES&page=0&size=10&sortBy=expenseDate&sortDir=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "expenses"],
              "query": [
                {"key": "category", "value": "UTILITIES"},
                {"key": "page", "value": "0"},
                {"key": "size", "value": "10"},
                {"key": "sortBy", "value": "expenseDate"},
                {"key": "sortDir", "value": "desc"}
              ]
            }
          }
        },
        {
          "name": "Get Expense By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/expenses/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "expenses", "1"]
            }
          }
        },
        {
          "name": "Update Expense",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"High Speed Fiber Internet\",\n  \"description\": \"Upgraded 300Mbps fiber plan\",\n  \"amount\": 2200.00,\n  \"expenseDate\": \"2026-11-16\",\n  \"category\": \"UTILITIES\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/expenses/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "expenses", "1"]
            }
          }
        },
        {
          "name": "Delete Expense",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/expenses/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "expenses", "1"]
            }
          }
        },
        {
          "name": "Get Monthly Spending Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/expenses/summary?year=2026&month=11",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "expenses", "summary"],
              "query": [
                {"key": "year", "value": "2026"},
                {"key": "month", "value": "11"}
              ]
            }
          }
        }
      ]
    }
  ]
}
